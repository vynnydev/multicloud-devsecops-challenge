        <!-- Instruções de Posicionamento -->
        <mxCell id="instructions-aws" value="📍 ONDE COLOCAR NO DRAW.IO:&#xa;&#xa;1. Abra o diagrama AWS (Imagem 2)&#xa;2. Localize o &quot;Public Subnet A&quot; (retângulo azul claro)&#xa;3. Adicione estes 3 componentes DENTRO do Public Subnet&#xa;4. Posicione ANTES do ALB e API Gateway&#xa;&#xa;ORDEM DO FLUXO:&#xa;Internet → FortiGate VM → FortiWeb WAF → ALB/API Gateway&#xa;&#xa;FortiManager: Pode ficar em uma área separada (fora das AZs)&#xa;para gerenciar todos os FortiGate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontStyle=1;fontSize=10;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="280" width="450" height="180" as="geometry" />
        </mxCell>

        <!-- Configurações -->
        <mxCell id="config-aws" value="⚙️ CONFIGURAÇÕES FORTINET AWS:&#xa;&#xa;FortiGate VM:&#xa;• Instance Type: c5.xlarge (4 vCPU, 8GB RAM)&#xa;• ENIs: 2 interfaces (Management + Data)&#xa;• Security Groups: Allow 443, 8443, SSH&#xa;• Features: IPS, IDS, SSL Inspection, VPN&#xa;&#xa;FortiWeb WAF:&#xa;• Instance Type: c5.large&#xa;• Protection: OWASP Top 10, API Security&#xa;• SSL Offloading: Enabled&#xa;&#xa;FortiManager:&#xa;• Instance Type: t3.medium&#xa;• Purpose: Central policy management&#xa;• Multi-cloud capable" style="rounded=1;whiteConnect=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=0;fontSize=9;spacing=10;" vertex="1" parent="1">
