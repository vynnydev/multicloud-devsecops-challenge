        <!-- Instruções de Posicionamento -->
        <mxCell id="instructions-azure" value="📍 ONDE COLOCAR NO DRAW.IO:&#xa;&#xa;1. Abra o diagrama Azure (Imagem 3)&#xa;2. Localize o &quot;Public Subnet (DMZ)&quot; (retângulo azul claro)&#xa;3. Adicione FortiGate-VM e FortiWeb DENTRO do Public Subnet&#xa;4. Posicione ANTES do Azure Front Door e Application Gateway&#xa;&#xa;ORDEM DO FLUXO:&#xa;Internet → FortiGate-VM → FortiWeb → Azure Front Door → Application Gateway&#xa;&#xa;FortiManager e FortiAnalyzer: &#xa;Coloque em uma área de &quot;Management Subnet&quot; separada&#xa;ou próximo aos recursos de Security &amp; Monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontStyle=1;fontSize=10;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="280" width="550" height="170" as="geometry" />
        </mxCell>

        <!-- Configurações -->
        <mxCell id="config-azure" value="⚙️ CONFIGURAÇÕES FORTINET AZURE:&#xa;&#xa;FortiGate-VM (NVA):&#xa;• VM Size: Standard_D4s_v3 (4 vCPU, 16GB RAM)&#xa;• Network Interfaces: 2 NICs (External + Internal)&#xa;• NSG Rules: HTTPS 443, SSH 22, FortiGate Admin 8443&#xa;• High Availability: Active-Passive with Azure LB&#xa;• Features: IPS/IDS, SSL Inspection, SD-WAN, VPN&#xa;&#xa;FortiWeb:&#xa;• VM Size: Standard_D2s_v3&#xa;• Integration: Azure Application Gateway&#xa;• Protection: OWASP Top 10, Bot Mitigation, API Security&#xa;&#xa;FortiManager:&#xa;• VM Size: Standard_D2s_v3&#xa;• Purpose: Unified policy management across AWS, Azure, GCP&#xa;• Integration: Azure Monitor, Sentinel&#xa;&#xa;FortiAnalyzer:&#xa;• VM Size: Standard_D4s_v3&#xa;• Storage: 500GB Premium SSD&#xa;• Integration: Azure Log Analytics, Sentinel SIEM&#xa;• Retention: 90 days logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=0;fontSize=9;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="470" width="550" height="220" as="geometry" />
        </mxCell>

        <!-- Integração com Azure Native -->
        <mxCell id="integration-azure" value="🔗 INTEGRAÇÃO COM SERVIÇOS NATIVOS AZURE:&#xa;&#xa;✓ Azure Firewall: Trabalha em conjunto (FortiGate = Inbound, Azure FW = Outbound)&#xa;✓ Azure Front Door: FortiWeb protege antes do Front Door&#xa;✓ Application Gateway: FortiWeb como backend do App Gateway&#xa;✓ Azure Sentinel: FortiAnalyzer envia logs via Syslog/CEF&#xa;✓ Azure Monitor: Métricas do FortiGate integradas&#xa;✓ Azure Key Vault: Armazenamento de certificados SSL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontStyle=1;fontSize=9;spacing=10;" vertex="1" parent="1">
